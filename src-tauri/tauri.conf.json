{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 安全卫士",
  "version": "0.1.2",
  "identifier": "com.technicalflight.aiguard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI 安全卫士",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "deb", "appimage"],
    "category": "Utility",
    "shortDescription": "本地优先的 AI 流量安全网关",
    "longDescription": "AI 安全卫士只接管发往 AI 服务的流量：请求侧脱敏、响应侧流式还原，并对七类风险信号做只读审计。敏感原文只存在于本机会话映射中，不落盘、不上传。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["zh-CN"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
